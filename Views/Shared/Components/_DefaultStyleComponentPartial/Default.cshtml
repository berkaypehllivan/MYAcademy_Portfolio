<style>
        :root {
            --forest: #123D32; --emerald: #16845B; --emerald-dark: #0F6B49;
            --mint: #DDF3E8; --soft: #EEF6F0;
            --bg: #E8F0EA; --bg-2: #F2F7F3; --card: #FFFFFF;
            --border: #D3E2D8; --text: #17231D; --muted: #566A5F;
            --shadow: 0 8px 28px rgba(18, 61, 50, .07); --shadow-hover: 0 14px 34px rgba(18, 61, 50, .13);
            --ease: all .25s ease;
        }
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); line-height: 1.65; overflow-x: hidden; }
        h1, h2, h3, h4, h5 { color: var(--text); font-weight: 700; letter-spacing: -.02em; }
        section { padding: 5.5rem 0; scroll-margin-top: 90px; }
        section.alt { background: var(--bg-2); }
        .sec-head { margin-bottom: 2.75rem; }
        .sec-title { font-size: 2.1rem; font-weight: 800; letter-spacing: -.03em; margin: 0 0 .4rem; }
        .sec-sub { color: var(--muted); max-width: 560px; margin: 0; }
        :focus-visible { outline: 3px solid var(--emerald); outline-offset: 2px; }

        /* Navbar: floating pill, no brand */
        .custom-navbar { padding: 1rem 0; }
        .nav-pill { display: flex; flex-wrap: wrap; align-items: center; background: rgba(255,255,255,.88); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid var(--border); border-radius: 60px; padding: .4rem .45rem .4rem .6rem; box-shadow: 0 6px 20px rgba(18,61,50,.06); transition: var(--ease); }
        .custom-navbar.scrolled .nav-pill { box-shadow: 0 10px 30px rgba(18,61,50,.14); }
        .nav-link { color: var(--muted) !important; font-weight: 500; font-size: .92rem; padding: .45rem .95rem !important; border-radius: 50px; transition: var(--ease); }
        .nav-link:hover { color: var(--forest) !important; background: var(--soft); }
        .nav-link.active { color: var(--forest) !important; background: var(--mint); font-weight: 700; }
        .nav-toggle { display: flex; justify-content: space-between; align-items: center; width: 100%; background: none; border: 0; font-weight: 600; padding: .35rem .5rem; color: var(--text); }

        .btn-main { background: var(--emerald); color: #fff !important; border: 0; padding: .65rem 1.4rem; border-radius: 50px; font-weight: 600; font-size: .92rem; display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; transition: var(--ease); box-shadow: 0 6px 16px rgba(22,132,91,.25); }
        .btn-main:hover { background: var(--forest); transform: translateY(-2px); }
        .btn-ghost { background: #fff; color: var(--text) !important; border: 1.5px solid var(--border); padding: .62rem 1.4rem; border-radius: 50px; font-weight: 600; font-size: .92rem; display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; transition: var(--ease); }
        .btn-ghost:hover { border-color: var(--emerald); color: var(--emerald-dark) !important; transform: translateY(-2px); }

        /* Hero */
        #home { padding-top: 8.5rem; min-height: 92vh; display: flex; align-items: center; }
        .hero-badge { display: inline-flex; gap: .5rem; padding: .4rem 1.05rem; background: #fff; border: 1px solid var(--border); border-radius: 50px; font-size: .875rem; font-weight: 600; margin-bottom: 1.4rem; }
        .hero-title { font-size: 3.3rem; font-weight: 800; line-height: 1.15; margin-bottom: 1rem; }
        .hero-title .name { color: var(--emerald); }
        .typing-container { font-size: 1.45rem; font-weight: 600; color: var(--forest); min-height: 2.3rem; display: flex; align-items: center; margin-bottom: 1.3rem; }
        .typing-cursor { width: 2.5px; height: 1.3em; background: var(--emerald); margin-left: 4px; border-radius: 2px; animation: blink .85s infinite; }
        @@keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
        .hero-desc { font-size: 1.1rem; color: var(--muted); max-width: 520px; margin-bottom: 2rem; }
        .social-btn { width: 42px; height: 42px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #fff; border: 1px solid var(--border); color: var(--muted); text-decoration: none; transition: var(--ease); }
        .social-btn:hover { background: var(--emerald); border-color: var(--emerald); color: #fff; transform: translateY(-3px); }

        /* Portrait: arch shape, no floating labels */
        .portrait { position: relative; max-width: 400px; margin: 0 auto; }
        .portrait::before { content: ''; position: absolute; inset: 22px -22px -22px 22px; border-radius: 200px 200px 32px 32px; background: var(--mint); }
        .portrait-frame { position: relative; aspect-ratio: 4/5; border-radius: 200px 200px 32px 32px; overflow: hidden; border: 6px solid #fff; box-shadow: var(--shadow); background: #fff; }
        .portrait-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

        /* About */
        .about-lead { font-size: 1.2rem; color: var(--text); font-weight: 500; line-height: 1.7; }
        .info-card { background: var(--card); border: 1px solid var(--border); border-radius: 24px; padding: 2rem; box-shadow: var(--shadow); height: 100%; display: flex; flex-direction: column; }
        .info-rows { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 1.1rem; }
        .info-row { display: flex; align-items: center; gap: 1rem; }
        .ico { width: 46px; height: 46px; border-radius: 14px; background: var(--mint); color: var(--emerald); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
        .info-label { font-size: .8rem; color: var(--muted); line-height: 1.3; }
        .info-value { font-weight: 600; overflow-wrap: anywhere; }

        .card-soft { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 1.6rem; box-shadow: var(--shadow); transition: var(--ease); }
        .card-soft:hover { box-shadow: var(--shadow-hover); }
        .pill { display: inline-flex; align-items: center; gap: .35rem; padding: .25rem .75rem; border-radius: 50px; font-size: .78rem; font-weight: 600; }
        .pill-green { background: var(--mint); color: var(--forest); }
        .pill-blue { background: #E1EDF9; color: #1F5FA0; }
        .pill-amber { background: #FBEBD3; color: #8F4F06; }
        .tag { display: inline-block; font-size: .78rem; font-weight: 500; padding: .22rem .7rem; border-radius: 50px; background: var(--soft); border: 1px solid var(--border); margin: .15rem .2rem .15rem 0; }

        /* Education: one-sided rail, same block repeated */
        .edu { max-width: 900px; }
        .edu-item { display: grid; grid-template-columns: 190px 30px 1fr; grid-template-areas: "date rail card"; column-gap: 1rem; padding-bottom: 1.75rem; }
        .edu-date { grid-area: date; text-align: right; padding-top: 1.45rem; font-weight: 700; }
        .edu-date small { display: block; color: var(--muted); font-weight: 500; }
        .edu-rail { grid-area: rail; position: relative; }
        .edu-rail::before { content: ''; position: absolute; left: 50%; top: 0; bottom: -1.75rem; width: 2px; background: var(--border); transform: translateX(-50%); }
        .edu-item:first-child .edu-rail::before { top: 1.95rem; }
        .edu-item:last-child { padding-bottom: 0; }
        .edu-item:last-child .edu-rail::before { display: none; }
        .edu-dot { position: absolute; top: 1.6rem; left: 50%; width: 14px; height: 14px; border-radius: 50%; background: var(--emerald); transform: translateX(-50%); box-shadow: 0 0 0 5px var(--mint); }
        .edu-card { grid-area: card; }

        /* Experience: résumé rows (role left, details right) */
        .exp-card { background: var(--card); border: 1px solid var(--border); border-left: 5px solid #B7D2C2; border-radius: 22px; padding: 1.9rem; box-shadow: var(--shadow); margin-bottom: 1.5rem; transition: var(--ease); }
        .exp-card.current { border-left-color: var(--emerald); }
        .exp-card:hover { box-shadow: var(--shadow-hover); }
        .exp-list { list-style: none; padding: 0; margin: 0 0 1rem; }
        .exp-list li { position: relative; padding-left: 1.5rem; margin-bottom: .45rem; color: var(--muted); font-size: .95rem; }
        .exp-list li::before { content: '\F26E'; font-family: 'bootstrap-icons'; position: absolute; left: 0; color: var(--emerald); }

        /* Skills: bento */
        .skill-card { position: relative; overflow: hidden; height: 100%; background: var(--card); border: 1px solid var(--border); border-radius: 26px; padding: 1.9rem; box-shadow: var(--shadow); }
        .skill-card > *:not(.ghost) { position: relative; }
        .skill-card.tint { background: var(--mint); border-color: transparent; }
        .skill-card.featured { background: var(--forest); border-color: transparent; color: #fff; }
        .skill-card.featured h4 { color: #fff; }
        .skill-card.featured .skill-desc { color: rgba(255,255,255,.72); }
        .skill-card.featured .ico { background: rgba(255,255,255,.12); color: #8FE3BC; }
        .ghost { position: absolute; right: -8px; bottom: -22px; font-size: 7.5rem; line-height: 1; color: var(--mint); opacity: .8; pointer-events: none; }
        .tint .ghost { color: #fff; opacity: .55; }
        .featured .ghost { color: rgba(255,255,255,.07); opacity: 1; }
        .skill-desc { color: var(--muted); font-size: .92rem; margin: .9rem 0 1.1rem; }
        .chip { display: inline-block; padding: .38rem .85rem; margin: .25rem .3rem .25rem 0; border-radius: 50px; background: var(--soft); border: 1px solid var(--border); font-size: .85rem; font-weight: 600; }
        .tint .chip { background: #fff; border-color: transparent; }
        .featured .chip { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.18); color: #fff; }

        /* Projects */
        .filter-btn { background: #fff; border: 1px solid var(--border); color: var(--muted); padding: .5rem 1.25rem; border-radius: 50px; font-size: .9rem; font-weight: 600; transition: var(--ease); }
        .filter-btn:hover { color: var(--forest); border-color: var(--emerald); }
        .filter-btn.active { background: var(--forest); border-color: var(--forest); color: #fff; }
        .project-card { background: #fff; border: 1px solid var(--border); border-radius: 22px; overflow: hidden; box-shadow: var(--shadow); height: 100%; display: flex; flex-direction: column; transition: var(--ease); }
        .project-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-hover); }
        .project-thumb { width: 100%; aspect-ratio: 16/9; overflow: hidden; background: var(--mint); }
        .project-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .project-body { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; }
        .project-desc { color: var(--muted); font-size: .92rem; flex: 1; }
        .project-footer { display: flex; justify-content: space-between; padding-top: 1rem; border-top: 1px solid var(--border); margin-top: auto; }
        .project-link { color: var(--text); text-decoration: none; font-size: .875rem; font-weight: 600; display: inline-flex; gap: .4rem; align-items: center; transition: var(--ease); }
        .project-link:hover { color: var(--emerald); }

        /* Contact */
        .contact-info { position: relative; overflow: hidden; height: 100%; background: var(--forest); color: #fff; border-radius: 26px; padding: 2.4rem; }
        .contact-info::after { content: ''; position: absolute; width: 260px; height: 260px; border-radius: 50%; right: -90px; bottom: -90px; background: rgba(143,227,188,.1); }
        .contact-info > * { position: relative; z-index: 1; }
        .contact-info h3 { color: #fff; }
        .c-item { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.4rem; }
        .c-ico { width: 46px; height: 46px; border-radius: 50%; background: rgba(255,255,255,.1); color: #8FE3BC; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; transition: var(--ease); }
        .c-item:hover .c-ico { background: #8FE3BC; color: var(--forest); }
        .c-label { font-size: .8rem; color: rgba(255,255,255,.62); }
        .c-link { color: #fff; font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
        a.c-link:hover { text-decoration: underline; }
        .reply-note { display: inline-flex; align-items: center; gap: .6rem; padding: .5rem 1rem; border-radius: 50px; background: rgba(255,255,255,.1); font-size: .85rem; }
        .live-dot { width: 9px; height: 9px; border-radius: 50%; background: #8FE3BC; animation: pulse 2s infinite; }
        @@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(143,227,188,.6); } 70%, 100% { box-shadow: 0 0 0 9px rgba(143,227,188,0); } }
        .contact-form-card { background: #fff; border: 1px solid var(--border); border-radius: 26px; padding: 2.4rem; box-shadow: var(--shadow); }
        .form-control { border: 1.5px solid var(--border); border-radius: 14px; padding: .8rem 1rem; background: var(--bg-2); transition: var(--ease); }
        .form-control:focus { border-color: var(--emerald); background: #fff; box-shadow: 0 0 0 4px rgba(22,132,91,.14); }
        .form-label { font-weight: 600; font-size: .875rem; }
        .btn-send i { transition: transform .25s ease; }
        .btn-send:hover i { transform: translateX(4px) rotate(-8deg); }

        footer { background: #fff; border-top: 1px solid var(--border); padding: 3rem 0 2rem; }
        .footer-link { color: var(--muted); text-decoration: none; font-size: .925rem; }
        .footer-link:hover { color: var(--emerald); }

        .scroll-to-top { position: fixed; bottom: 26px; right: 26px; width: 46px; height: 46px; border-radius: 50%; background: var(--forest); color: #fff; border: 0; box-shadow: 0 8px 22px rgba(18,61,50,.25); opacity: 0; visibility: hidden; transform: translateY(12px); transition: var(--ease); z-index: 1000; }
        .scroll-to-top.visible { opacity: 1; visibility: visible; transform: none; }
        .scroll-to-top:hover { background: var(--emerald); }

        @@media (max-width: 991.98px) {
            .nav-pill { width: 100%; border-radius: 22px; padding: .45rem .75rem; }
            .navbar-collapse { width: 100%; padding: .5rem 0; }
            .hero-title { font-size: 2.5rem; }
            .portrait { margin-top: 2.5rem; max-width: 320px; }
        }
        @@media (max-width: 767.98px) {
            section { padding: 4rem 0; }
            .edu-item { grid-template-columns: 22px 1fr; grid-template-areas: "rail date" "rail card"; }
            .edu-date { text-align: left; padding: .2rem 0 .5rem; }
            .edu-dot { top: .45rem; }
            .edu-item:first-child .edu-rail::before { top: .75rem; }
            .contact-info, .contact-form-card { padding: 1.7rem; }
        }
        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .typing-cursor, .live-dot { animation: none; }
        }
    </style>
