    @model List<MYAcademy_Portfolio.Entities.Project>
@{
        var categories = Model.Select(x => x.Category.CategoryName).Distinct().ToList();

}

<section id="projects" class="alt">
        <div class="container">
            <div class="sec-head">
                <h2 class="sec-title">Projelerim</h2>
                <p class="sec-sub">Öğrendiklerimi gerçek ürünlere dönüştürdüğüm çalışmalar.</p>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-5" id="projectFilterGroup">
                <button class="filter-btn active" data-filter="all">Tümü</button>
                @foreach (var cat in categories)
                {
                    <button class="filter-btn" data-filter="@cat">@cat</button>
                }
            </div>

            <div class="row g-4" id="projectGrid">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 project-item" data-category="@item.Category.CategoryName">
                        <div class="project-card">
                            <div class="project-thumb"><img src="@item.CoverImageUrl" alt="@item.Title" loading="lazy" /></div>
                            <div class="project-body">
                                <span class="pill pill-green mb-3 align-self-start">@item.Category.CategoryName</span>
                                <h3 class="fs-5 mb-2">@item.Title</h3>
                                <p class="project-desc">@item.Description</p>
                                <div class="mb-3">
                                    <span class="tag">ASP.NET Core</span><span class="tag">EF Core</span><span class="tag">SQL Server</span><span class="tag">Bootstrap</span>
                                </div>
                                <div class="project-footer">
                                    <a href="@item.GithubUrl" target="_blank" rel="noopener noreferrer" class="project-link"><i class="bi bi-github"></i> GitHub</a>
                                    <a href="#projects" class="project-link"><i class="bi bi-box-arrow-up-right"></i> Canlı Demo</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
