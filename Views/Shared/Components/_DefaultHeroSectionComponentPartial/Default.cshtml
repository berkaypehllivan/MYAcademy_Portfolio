<section id="home">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <h1 class="hero-title">Merhaba, ben <br /><span class="name">@ViewBag.FirstLastName</span></h1>
                <p class="hero-desc">@ViewBag.JobTitle</p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="#projects" class="btn-main"><i class="bi bi-grid-fill"></i> Projelerimi İncele</a>
                    <a href="#contact" class="btn-ghost"><i class="bi bi-chat-dots"></i> Benimle İletişime Geç</a>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a href="@ViewBag.Github" target="_blank" rel="noopener noreferrer" class="social-btn"
                       aria-label="GitHub"><i class="bi bi-github"></i></a>
                    <a href="@ViewBag.Linkedin" target="_blank" rel="noopener noreferrer" class="social-btn"
                       aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a class="social-btn" href="/Contact" data-section="contact"><i class="bi bi-envelope"></i></a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="portrait">
                    <div class="portrait-frame">
                        <img src="@ViewBag.ImageUrl" alt="@ViewBag.FirstLastName">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>