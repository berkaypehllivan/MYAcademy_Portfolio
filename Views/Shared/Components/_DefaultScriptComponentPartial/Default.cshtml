<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {

        // ==========================================
        // 1. TYPING ANIMATION (YAZI EFEKTİ)
        // ==========================================
        const typed = document.getElementById('typedText');
        if (typed) {
            const sentences = [
                "Modern Web Uygulamaları Geliştiriyorum.",
                "Yazılımla Problemlere Çözüm Üretiyorum.",
                "Kullanıcı Odaklı Deneyimler Tasarlıyorum.",
                "Yeni Teknolojilerle Geleceği İnşa Ediyorum."
            ];
            let si = 0, ci = 0, deleting = false;

            function typeLoop() {
                const s = sentences[si];
                typed.textContent = s.substring(0, deleting ? --ci : ++ci);
                let delay = deleting ? 40 : 75;

                if (!deleting && ci === s.length) {
                    delay = 1800;
                    deleting = true;
                } else if (deleting && ci === 0) {
                    deleting = false;
                    si = (si + 1) % sentences.length;
                    delay = 350;
                }
                setTimeout(typeLoop, delay);
            }
            setTimeout(typeLoop, 500);
        }


        // ==========================================
        // 2. NAVBAR SHADOW & SCROLL-TO-TOP BUTTON
        // ==========================================
        const navbar = document.getElementById('mainNavbar');
        const topBtn = document.getElementById('scrollToTopBtn');

        window.addEventListener('scroll', function () {
            const isScrolled = window.scrollY > 50;
            if (navbar) navbar.classList.toggle('scrolled', isScrolled);
            if (topBtn) topBtn.classList.toggle('visible', isScrolled);
        }, { passive: true });

        if (topBtn) {
            topBtn.addEventListener('click', () => {
                history.pushState(null, '', '/');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // ==========================================
// 3. SPA MİMARİSİ (CLEAN URL & TIKLAMA YÖNETİMİ)
// ==========================================
const navItems = document.querySelectorAll('.navbar-nav .nav-link');
const collapseEl = document.getElementById('navbarContent');

navItems.forEach(function (link) {
    link.addEventListener('click', function (e) {
        const href = this.getAttribute('href');
        const sectionAttr = this.getAttribute('data-section');

        if (href) {
            e.preventDefault();

            // 1. Hedef ID'yi öncelikle data-section'dan, yoksa href'ten küçük harfe çevirerek al
            let targetId = sectionAttr ? sectionAttr.toLowerCase() : href.replace('/Default/', '').replace('/', '').replace('#', '').toLowerCase();
            
            // Default/Index için varsayılan 'home' bölümü
            if (targetId === 'default' || targetId === 'index') targetId = 'home';

            const targetElement = document.getElementById(targetId);

            // 2. URL'i sayfa yenilenmeden güncelle (/Experience, /About vs.)
            history.pushState(null, '', href);

            // 3. Hedefe pürüzsüz kaydır
            if (targetElement) {
                targetElement.scrollIntoView({ behavior: 'smooth' });
            } else if (targetId === 'home') {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Mobil menü açıksa kapat
            if (window.innerWidth < 992 && collapseEl && collapseEl.classList.contains('show')) {
                bootstrap.Collapse.getInstance(collapseEl).hide();
            }
        }
    });
});

// Tarayıcı Geri/İleri butonları senkronizasyonu
window.addEventListener('popstate', function () {
    const path = window.location.pathname.replace('/Default/', '').replace('/', '').toLowerCase();
    const targetId = path || 'home';
    const targetElement = document.getElementById(targetId);
    if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth' });
    } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
});

// Sayfa ilk yüklendiğinde Controller'dan gelen section'a gitme
const activeSection = "@ViewBag.ActiveSection";
if (activeSection) {
    const targetElement = document.getElementById(activeSection.toLowerCase());
    if (targetElement) {
        setTimeout(() => {
            targetElement.scrollIntoView({ behavior: 'smooth' });
        }, 150);
    }
}


// ==========================================
// 4. SCROLLSPY (KAYDIRDIKÇA AKTİF LİNKİ VURGULAMA)
// ==========================================
const spySections = Array.from(navItems).map(l => {
    const secAttr = l.getAttribute('data-section');
    const href = l.getAttribute('href');
    let targetId = secAttr ? secAttr.toLowerCase() : href.replace('/Default/', '').replace('/', '').replace('#', '').toLowerCase();
    if (targetId === 'default' || targetId === 'index') targetId = 'home';
    return document.getElementById(targetId);
}).filter(Boolean);

function updateActiveLink() {
    if (spySections.length === 0) return;

    const offset = 140;
    let current = spySections[0];

    spySections.forEach(function (sec) {
        if (sec.getBoundingClientRect().top <= offset) {
            current = sec;
        }
    });

    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        current = spySections[spySections.length - 1];
    }

    navItems.forEach(function (l) {
        const secAttr = l.getAttribute('data-section');
        const href = l.getAttribute('href');
        let targetId = secAttr ? secAttr.toLowerCase() : href.replace('/Default/', '').replace('/', '').replace('#', '').toLowerCase();
        if (targetId === 'default' || targetId === 'index') targetId = 'home';
        
        l.classList.toggle('active', targetId === current.id);
    });
}

let ticking = false;
window.addEventListener('scroll', function () {
    if (!ticking) {
        requestAnimationFrame(function () {
            updateActiveLink();
            ticking = false;
        });
        ticking = true;
    }
}, { passive: true });

updateActiveLink();

        // ==========================================
        // 5. PROJE KATEGORİ FİLTRELEME (PORTFOLIO)
        // ==========================================
        const filterButtons = document.querySelectorAll('#projectFilterGroup .filter-btn');
        const projectItems = document.querySelectorAll('.project-item');

        filterButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                filterButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');
                projectItems.forEach(function (item) {
                    item.style.display = (filter === 'all' || item.getAttribute('data-category') === filter) ? '' : 'none';
                });
            });
        });


        // ==========================================
        // 6. İLETİŞİM FORMU (AJAX GÖNDERİMİ)
        // ==========================================
        const form = document.getElementById('contactForm');
        const successBox = document.getElementById('formSuccessMessage');

        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();

                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }

                const btn = form.querySelector('button[type="submit"]');
                if (btn) btn.disabled = true;

                try {
                    const res = await fetch('@Url.Action("SendMessage", "Default")', {
                        method: 'POST',
                        body: new FormData(form)
                    });

                    if (res.ok) {
                        form.reset();
                        form.classList.remove('was-validated');
                        if (successBox) successBox.classList.remove('d-none');
                    } else {
                        alert('Mesaj gönderilemedi, lütfen tekrar deneyin.');
                    }
                } catch (err) {
                    alert('Bağlantı hatası oluştu.');
                } finally {
                    if (btn) btn.disabled = false;
                }
            });
        }

    });
</script>