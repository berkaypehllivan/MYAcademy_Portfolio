@model List<MYAcademy_Portfolio.Entities.Education>

<section id="education">
    <div class="container">
        <div class="sec-head">
            <h2 class="sec-title">Eğitim Hayatım</h2>
            <p class="sec-sub">Yazılım dünyasına uzanan yolculuğumun temellerinin atıldığı yerler.</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="edu">
                @foreach (var item in Model)
                {
                    <div class="edu-item">
                        <div class="edu-date">
                            @item.Duration
                            @if (!string.IsNullOrWhiteSpace(item.Location))
                            {
                                <small>@item.Location</small>
                            }
                        </div>

                        <div class="edu-rail"><span class="edu-dot"></span></div>

                        <div class="edu-card card-soft">
                            <h3 class="edu-title">@item.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(item.SubTitle))
                            {
                                <div class="edu-subtitle">@item.SubTitle</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="edu-desc">@item.Description</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-center text-secondary">Henüz eğitim bilgisi eklenmedi.</p>
        }
    </div>
</section>