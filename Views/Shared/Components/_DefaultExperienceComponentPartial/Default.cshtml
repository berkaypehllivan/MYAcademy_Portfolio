@model List<MYAcademy_Portfolio.Entities.Experience>

<section id="experience" class="alt">
    <div class="container">
        <div class="sec-head">
            <h2 class="sec-title">Deneyimlerim</h2>
            <p class="sec-sub">Gerçek dünya problemlerini çözerken edindiğim tecrübeler.</p>
        </div>

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                // Her satırı ayrı bir sorumluluk olarak böl, boş satırları at
                var responsibilities = (item.Description ?? string.Empty)
                    .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                <div class="exp-card">
                    <div class="row g-4">
                        <div class="col-lg-4">
                            <span class="pill pill-amber mb-3"><i class="bi bi-calendar3"></i> @item.Duration</span>
                            <h3 class="fs-5 mb-1">@item.Title</h3>
                            <div class="fw-semibold mb-1" style="color: var(--emerald);">@item.CompanyName</div>

                            @if (!string.IsNullOrWhiteSpace(item.SideTitle))
                            {
                                <div class="text-secondary small mb-3">@item.WorkType</div>
                            }

                            <div class="d-flex flex-wrap gap-2">
                                @if (!string.IsNullOrWhiteSpace(item.SideTitle))
                                {
                                    <span class="pill pill-amber">@item.SideTitle</span>
                                }
                                @if (item.IsActive)
                                {
                                    <span class="pill pill-amber">Devam ediyor</span>
                                }
                            </div>
                        </div>

                        <div class="col-lg-8">
                            @if (responsibilities.Length > 0)
                            {
                                <ul class="exp-list">
                                    @foreach (var line in responsibilities)
                                    {
                                        <li>@line</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-center text-secondary">Henüz deneyim bilgisi eklenmedi.</p>
        }
    </div>
</section>