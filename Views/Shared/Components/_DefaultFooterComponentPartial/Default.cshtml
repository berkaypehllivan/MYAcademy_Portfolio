<footer>
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-lg-4 text-center text-lg-start">
                    <div class="fw-bold">@ViewBag.FirstLastName</div>
                    <div class="text-secondary small">@ViewBag.JobTitle</div>
                </div>
                <div class="col-lg-6 text-center">
                    <a href="/Default/Index" class="footer-link mx-1" data-section="home">Ana Sayfa</a>
                    <a href="/About" class="footer-link mx-1" data-section="about">Hakkımda</a>
                    <a href="/Education" class="footer-link mx-1" data-section="education">Eğitim Hayatım</a>
                    <a href="/Experience" class="footer-link mx-1" data-section="experience">Deneyimlerim</a>
                    <a href="/Skills" class="footer-link mx-1" data-section="skills">Yeteneklerim</a>
                    <a href="/Projects" class="footer-link mx-1" data-section="projects">Projelerim</a>
                    <a href="/Contact" class="footer-link mx-1" data-section="contact">İletişim</a>
                </div>
                <div class="col-lg-2 text-center text-lg-end">
                    <div class="d-inline-flex gap-2">
                        <a href="@ViewBag.Github" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub"><i class="bi bi-github"></i></a>
                        <a href="@ViewBag.Linkedin" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
            </div>
            <hr class="opacity-25 my-4">
            <p class="text-secondary small text-center mb-0">© 2026 @ViewBag.FirstLastName. Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <button id="scrollToTopBtn" class="scroll-to-top" aria-label="Sayfanın Başına Çık"><i class="bi bi-chevron-up"></i></button>
