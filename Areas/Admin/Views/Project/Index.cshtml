@model List<MYAcademy_Portfolio.Entities.Project>
@{
    ViewData["Title"] = "Proje Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    
    // Controller'dan ViewBag ile gelen kategorileri listeye çevir
    var categories = ViewBag.Categories as List<MYAcademy_Portfolio.Entities.Category>;
}

<div class="container-fluid px-0 py-3">

    <div class="pd-page-header">
        <div class="pd-header-left">
            <div class="pd-header-icon">
                <div class="pd-ico forest">🧩</div>
            </div>
            <div class="pd-header-text">
                <h1 class="pd-title">Proje Portfolyosu</h1>
                <p class="pd-subtitle">Geliştirdiğiniz yazılım projelerini, kullandığınız teknolojileri ve demo
                    bağlantılarını sergileyerek çalışmalarınızı öne çıkarın.</p>
                </div>
            </div>
                <div class="pd-header-right">
                    <a href="/Admin/Project/Create" class="btn btn-primary px-3 py-2 rounded-3 ms-auto">
                        <i class="bx bx-plus"></i> Yeni Proje Ekle
                    </a>
                </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #f9fafb;">
                            <tr>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600; width: 60px;">Görsel</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600;">Proje Adı</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600;">Kategori</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600;">Etiketler</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600;">Aktif - Pasif</th>
                                <th class="border-bottom-0 text-uppercase text-secondary text-end"
                                    style="font-size: 12px; font-weight: 600; width: 160px;">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody class="border-top-0">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="bg-light rounded-3 overflow-hidden d-flex align-items-center justify-content-center"
                                             style="width: 50px; height: 35px;">
                                            <img src="@item.CoverImageUrl" alt="@item.Title"
                                                 class="img-fluid w-100 h-100 object-fit-cover" />
                                        </div>
                                    </td>

                                    <td>
                                        <div class="fw-medium text-dark">@item.Title</div>
                                        <div class="d-flex gap-2 mt-1">
                                            @if (!string.IsNullOrEmpty(item.GithubUrl))
                                            {
                                                <a href="@item.GithubUrl" target="_blank" class="text-decoration-none small"
                                                   style="font-size:11px;">
                                                    <i class="bi bi-github"></i> GitHub
                                                </a>
                                            }

                                            @if (!string.IsNullOrEmpty(item.LiveDemoUrl))
                                            {
                                                <a href="@item.LiveDemoUrl" target="_blank"
                                                   class="text-decoration-none small text-success" style="font-size:11px;">
                                                    <i class="bi bi-box-arrow-up-right"></i> Canlı Demo
                                                </a>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">
                                            @(item.Category?.CategoryName ?? "Kategorisiz")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="text-muted small text-truncate" style="max-width: 150px;"
                                             title="@item.Keywords">
                                            @item.Keywords
                                        </div>
                                    </td>
                                    <td>
                                        <span
                                            class="badge rounded-pill px-3 py-2 fw-medium @(item.IsActive ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">
                                            @(item.IsActive ? "Aktif" : "Pasif")
                                        </span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a href="/Admin/Project/Create/@item.ProjectId"
                                           class="btn btn-sm text-primary bg-primary bg-opacity-10 border-0 rounded-pill px-3 me-1 fw-medium">
                                            Düzenle
                                        </a>

                                        <a href="/Admin/Project/Delete/@item.ProjectId" data-name="@item.Title"
                                           class="btn btn-sm text-danger bg-danger bg-opacity-10 border-0 rounded-pill px-3 fw-medium btn-delete">
                                            Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- KATEGORİ YÖNETİM MODALI (POPUP) -->
    <div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
            
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">Kategori Yönetimi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
            
                <div class="modal-body">
                    <!-- Hızlı Kategori Ekleme Formu -->
                    <form asp-action="AddCategory" method="post" class="d-flex gap-2 mb-4">
                        <input type="text" name="categoryName" class="form-control rounded-3"
                               placeholder="Yeni Kategori Adı (Örn: Web Uygulamaları)" required />
                        <button type="submit" class="btn btn-primary rounded-3 text-nowrap">Ekle</button>
                    </form>

                    <!-- Mevcut Kategoriler Listesi -->
                    <h6 class="fw-bold fs-6 text-muted mb-3">Mevcut Kategoriler</h6>
                    <ul class="list-group list-group-flush rounded-3 border">
                        @if (categories != null && categories.Any())
                        {
                            foreach (var cat in categories)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2">
                                    <span class="fw-medium text-dark">@cat.CategoryName</span>
                                    <a href="/Admin/Project/DeleteCategory/@cat.CategoryId"
                                       class="btn btn-sm text-danger btn-delete" data-name="@cat.CategoryName"
                                       title="Projeye bağlıysa silinemez">
                                        <i class="bx bx-trash"></i>
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted small py-2">Henüz kategori eklenmemiş.</li>
                        }
                    </ul>
                    <div class="form-text small mt-2">Not: İçerisinde proje bulunan kategoriler güvenlik gereği silinemez.
                    </div>
                </div>
            
            </div>
        </div>
    </div>