@model List<MYAcademy_Portfolio.Entities.Education>
@{
    ViewData["Title"] = "Eğitim Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-0 py-3">
    <div class="pd-page-header">
        <div class="pd-header-left">
            <div class="pd-header-icon">
                <i class="bx bx-education"></i>
            </div>
            <div class="pd-header-text">
                <h1 class="pd-title">Eğitim Geçmişi</h1>
                <p class="pd-subtitle">Akademik bilgilerinizi, mezuniyet durumlarınızı ve eğitim hayatınızdaki önemli
                    dönüm noktalarını düzenleyin.</p>
                </div>
            </div>
        
            <div class="pd-header-right">
                <a href="/Admin/Education/Create" class="btn btn-primary px-3 py-2 rounded-3 ms-auto">
                    <i class="bx bx-plus"></i> Yeni Eğitim Ekle
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #f9fafb;">
                            <tr>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600; width: 80px;">Sıra</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600; letter-spacing: 0.03em;">Kurum (Başlık)</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600; letter-spacing: 0.03em;">Bölüm (Alt Başlık)
                                </th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600; letter-spacing: 0.03em;">Tarih</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600; letter-spacing: 0.03em;">Konum</th>
                                <th class="border-bottom-0 text-uppercase text-secondary text-end"
                                    style="font-size: 12px; font-weight: 600; letter-spacing: 0.03em;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">
                                            @(item.DisplayOrder)
                                        </span>
                                    </td>
                                    <td class="fw-medium text-dark">@item.Title</td>
                                    <td class="text-muted small">@item.SubTitle</td>
                                    <td>
                                        <span
                                        class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">@item.Duration</span>
                                    </td>
                                    <td class="text-muted small">@item.Location</td>
                                    <td class="text-end text-nowrap">
                                        <form asp-action="MoveUp" asp-route-id="@item.EducationId" method="post"
                                              class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-light border-0 rounded-pill px-2 me-1"
                                                    title="Yukarı Taşı">
                                                <i class="bx bx-arrow-up"></i>
                                            </button>
                                        </form>
                                        <form asp-action="MoveDown" asp-route-id="@item.EducationId" method="post"
                                              class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-light border-0 rounded-pill px-2 me-1"
                                                    title="Aşağı Taşı">
                                                <i class="bx bx-arrow-down"></i>
                                            </button>
                                        </form>
                                        <a href="/Admin/Education/Create/@item.EducationId"
                                           class="btn btn-sm text-primary bg-primary bg-opacity-10 border-0 rounded-pill px-3 me-1 fw-medium">
                                            Düzenle
                                        </a>
                                        <a href="/Admin/Education/Delete/@item.EducationId"
                                           class="btn btn-sm text-danger bg-danger bg-opacity-10 border-0 rounded-pill px-3 fw-medium btn-delete">
                                            Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>