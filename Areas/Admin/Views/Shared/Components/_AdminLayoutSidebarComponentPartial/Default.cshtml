  @model MYAcademy_Portfolio.Entities.About
@{
           var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string Active(string ctrl) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
     
<aside id="sidebar-wrapper">
            <nav class="sidebar-nav">
                <div class="nav-group-title">Genel</div>
                <a href="/Admin/Dashboard/Index" class="sidebar-link @Active("Dashboard")">
                    <i class="bx bx-pie-chart-alt-2"></i><span>Dashboard</span>
                </a>

                <div class="nav-group-title">İçerik</div>
                <a href="/Admin/About/Index" class="sidebar-link @Active("About")">
                    <i class="bx bx-user"></i><span>Hakkımda</span>
                </a>
                <a href="/Admin/Contact/Index" class="sidebar-link @Active("Contact")">
                    <i class="bx bx-phone"></i><span>İletişim</span>
                </a>
                <a href="/Admin/Education/Index" class="sidebar-link @Active("Education")">
                    <i class="bx bx-education"></i><span>Eğitim</span>
                </a>
                <a href="/Admin/Experience/Index" class="sidebar-link @Active("Experience")">
                    <i class="bx bx-briefcase"></i><span>Deneyimler</span>
                </a>
                <a href="/Admin/Skill/Index" class="sidebar-link @Active("Skill")">
                    <i class="bx bx-code-alt"></i><span>Yetenekler</span>
                </a>
                <a href="/Admin/Project/Index" class="sidebar-link @Active("Project")">
                    <i class="bx bx-grid"></i><span>Projeler</span>
                </a>

                <div class="nav-group-title">İletişim</div>
                <a href="/Admin/Message/Index" class="sidebar-link @Active("Message")">
                    <i class="bx bx-envelope"></i><span>Mesajlar</span>
@await Component.InvokeAsync(name: "_AdminLayoutUnreadMessageBadgeViewComponentPartial")
                </a>
            </nav>

            <!-- Sidebar Alt Alan: Siteyi Görüntüle & Kullanıcı Bilgisi -->
            <div class="sidebar-footer-group">
                <a href="/Default" target="_blank" class="sidebar-link sidebar-site-btn mb-2">
                    <i class="bx bx-export"></i><span>Siteyi Görüntüle</span>
                </a>

                <div class="sidebar-user">
                    <div class="user-avatar">
                    <img src="@Model.ImageUrl"/>
                    </div>
                    <div class="overflow-hidden">
                        <div class="fw-semibold text-white text-truncate" style="font-size: 0.83rem;">Berkay PEHLİVAN</div>
                        <div style="font-size: 0.7rem; color: var(--mint); opacity: .7;">Yönetici</div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="sidebar-overlay" onclick="toggleSidebar()"></div>
