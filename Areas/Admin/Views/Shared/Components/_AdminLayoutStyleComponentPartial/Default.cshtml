<style>
            :root {
                /* ===== MARKA PALETİ ===== */
                --forest: #123D32; /* Ana marka rengi (sidebar) */
                --emerald: #16845B; /* Birincil buton ve aktif alanlar */
                --mint: #DDF3E8; /* Açık yeşil yüzeyler */
                --soft: #EEF6F0; /* İkincil arka planlar */
                --white: #FFFFFF; /* Kart ve içerik yüzeyleri */
                --bg: #F7F9F7; /* Genel sayfa arka planı */
                --border: #E3EAE5; /* Kenarlıklar ve ayırıcılar */
                --text: #17231D; /* Başlıklar ve ana metin */
                --text-2: #64746A; /* Açıklamalar ve ikincil metinler */

                --success: #16845B; /* Başarılı işlemler */
                --warning: #D97706; /* Uyarılar */
                --danger: #DC4545; /* Hatalar, silme */
                --info: #2878C7; /* Bilgilendirme */
                /* ===== TÜRETİLMİŞ TONLAR ===== */
                --emerald-dark: color-mix(in srgb, var(--emerald) 80%, black);
                --danger-dark: color-mix(in srgb, var(--danger) 80%, black);
                --warning-dark: color-mix(in srgb, var(--warning) 75%, black);
                --info-dark: color-mix(in srgb, var(--info) 80%, black);
                --danger-soft: color-mix(in srgb, var(--danger) 12%, white);
                /* ===== SIDEBAR ===== */
                --sidebar-bg: var(--forest);
                --sidebar-surface: color-mix(in srgb, var(--forest) 90%, white);
                --sidebar-active: var(--emerald);
                --sidebar-text: var(--mint);
                --sidebar-border: rgba(221, 243, 232, 0.10);
                /* ===== ESKİ DEĞİŞKEN ADLARI ===== */
                --bg-main: var(--bg);
                --card-bg: var(--white);
                --text-primary: var(--text);
                --text-secondary: var(--text-2);
                --primary-accent: var(--emerald);
                --primary-accent-hover: var(--emerald-dark);
                --border-color: var(--border);
                --pastel-purple: var(--soft);
                --radius-md: 12px;
                --radius-lg: 16px;
                --shadow-subtle: 0 4px 20px rgba(18, 61, 50, 0.04);
                --sidebar-width: 260px;
                --transition-base: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                /* ===== BOOTSTRAP ===== */
                --bs-primary: #16845B;
                --bs-primary-rgb: 22, 132, 91;
                --bs-success: #16845B;
                --bs-success-rgb: 22, 132, 91;
                --bs-warning: #D97706;
                --bs-warning-rgb: 217, 119, 6;
                --bs-danger: #DC4545;
                --bs-danger-rgb: 220, 69, 69;
                --bs-info: #2878C7;
                --bs-info-rgb: 40, 120, 199;
                --bs-body-color: #17231D;
                --bs-border-color: #E3EAE5;
                --bs-body-font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            }

            .btn-primary,
.btn-success {
    --bs-btn-color: #fff !important;
    --bs-btn-bg: var(--emerald) !important;
    --bs-btn-border-color: var(--emerald) !important;
    --bs-btn-hover-color: #fff !important;
    --bs-btn-hover-bg: var(--emerald-dark) !important;
    --bs-btn-hover-border-color: var(--emerald-dark) !important;
    --bs-btn-active-color: #fff !important;
    --bs-btn-active-bg: var(--forest) !important;
    --bs-btn-active-border-color: var(--forest) !important;
    --bs-btn-disabled-color: #fff !important;
    --bs-btn-disabled-bg: var(--emerald) !important;
    --bs-btn-disabled-border-color: var(--emerald) !important;
    --bs-btn-focus-shadow-rgb: 22, 132, 91 !important;

    background-color: var(--emerald) !important;
    border-color: var(--emerald) !important;
    color: #ffffff !important;
    box-shadow: 0 1px 2px rgba(18, 61, 50, 0.18), 0 8px 16px -8px rgba(22, 132, 91, 0.65) !important;
}

.btn-primary:hover,
.btn-success:hover {
    background-color: var(--emerald-dark) !important;
    border-color: var(--emerald-dark) !important;
    color: #ffffff !important;
    box-shadow: 0 2px 4px rgba(18, 61, 50, 0.2), 0 12px 20px -8px rgba(22, 132, 91, 0.7) !important;
}

.btn-outline-primary,
.btn-outline-success {
    --bs-btn-color: var(--emerald-dark) !important;
    --bs-btn-border-color: color-mix(in srgb, var(--emerald) 40%, white) !important;
    --bs-btn-hover-color: var(--emerald-dark) !important;
    --bs-btn-hover-bg: var(--mint) !important;
    --bs-btn-hover-border-color: var(--emerald) !important;
    --bs-btn-active-color: var(--forest) !important;
    --bs-btn-active-bg: var(--mint) !important;
    --bs-btn-active-border-color: var(--emerald) !important;
    --bs-btn-focus-shadow-rgb: 22, 132, 91 !important;
}

/* --- Bootstrap Text Utilitileri --- */
.text-primary,
.text-success {
    color: var(--emerald) !important;
}

/* --- Bootstrap Background (Yüzey & Rozet) Utilitileri --- */
.bg-primary,
.bg-success {
    background-color: var(--emerald) !important;
}

.bg-primary.bg-opacity-10,
.bg-success.bg-opacity-10 {
    background-color: var(--mint) !important;
}

/* --- Form Odaklanma (Focus) & Checkbox Stilleri --- */
.form-control:focus,
.form-select:focus {
    border-color: var(--emerald) !important;
    box-shadow: 0 0 0 3px rgba(22, 132, 91, 0.14) !important;
}

.form-check-input:checked {
    background-color: var(--emerald) !important;
    border-color: var(--emerald) !important;
}

.form-check-input:focus {
    border-color: var(--emerald) !important;
    box-shadow: 0 0 0 0.25rem rgba(22, 132, 91, 0.25) !important;
}

/* --- Pagination (Sayfalama) Butonları --- */
.page-item.active .page-link {
    background-color: var(--emerald) !important;
    border-color: var(--emerald) !important;
}

.page-link {
    color: var(--emerald) !important;
}

.page-link:hover {
    color: var(--emerald-dark) !important;
    background-color: var(--soft) !important;
}

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                background-color: var(--bg-main);
                color: var(--text-primary);
                margin: 0;
                min-height: 100vh;
                overflow-x: hidden;
                font-size: 0.925rem;
            }

            h1, h2, h3, h4, h5, h6 {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                color: var(--text-primary);
                letter-spacing: -0.02em;
            }

            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-thumb {
                background: color-mix(in srgb, var(--text-2) 35%, white);
                border-radius: 4px;
            }

            /* ========== SIDEBAR ========== */
            #sidebar-wrapper {
                width: var(--sidebar-width);
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background-color: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                z-index: 1040;
                box-shadow: 4px 0 25px rgba(18, 61, 50, 0.14);
                transition: transform 0.3s ease;
            }

            .sidebar-brand {
                padding: 22px 20px 18px;
                border-bottom: 1px solid var(--sidebar-border);
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
            }

            .brand-mark {
                width: 38px;
                height: 38px;
                background: linear-gradient(135deg, color-mix(in srgb, var(--emerald) 70%, white) 0%, var(--emerald) 100%);
                color: #fff;
                font-weight: 800;
                font-size: 1.2rem;
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 12px rgba(22, 132, 91, 0.35);
            }

            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                padding: 10px 14px 16px;
            }

            .nav-group-title {
                font-size: 0.68rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: rgba(221, 243, 232, 0.5);
                margin: 18px 10px 8px;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 9px 12px;
                margin-bottom: 2px;
                border-radius: var(--radius-md);
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 0.88rem;
                font-weight: 500;
                transition: var(--transition-base);
                position: relative;
            }

                .sidebar-link i {
                    font-size: 1.05rem;
                    color: rgba(221, 243, 232, 0.7);
                }

                .sidebar-link:hover {
                    color: #fff;
                    background: rgba(255, 255, 255, 0.07);
                }

                    .sidebar-link:hover i {
                        color: #fff;
                    }

                .sidebar-link.active {
                    background-color: var(--sidebar-active);
                    color: #fff;
                    font-weight: 600;
                    box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.35);
                }

                    .sidebar-link.active i {
                        color: #fff;
                    }

                    .sidebar-link.active::before {
                        content: '';
                        position: absolute;
                        left: -8px;
                        top: 6px;
                        bottom: 6px;
                        width: 4px;
                        border-radius: 4px;
                        background: var(--mint);
                    }

            .sidebar-footer-group {
                padding: 0 14px 14px;
            }

            .sidebar-site-btn {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid var(--sidebar-border);
                color: var(--mint) !important;
            }

                .sidebar-site-btn:hover {
                    background: var(--sidebar-active) !important;
                    color: #fff !important;
                    border-color: transparent;
                }

            .sidebar-user {
                padding: 12px 14px;
                background: var(--sidebar-surface);
                border-radius: var(--radius-md);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .user-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--emerald), var(--mint));
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--forest);
                font-weight: 700;
                font-size: 0.8rem;
                flex-shrink: 0;
            }

            /* ========== MAIN WRAPPER ========== */
            #main-content-wrapper {
                margin-left: var(--sidebar-width);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                min-width: 0;
                transition: margin-left 0.3s ease;
                position: relative;
            }

            /* ========== MOBİL MENÜ TOGGLE BUTONU ========== */
            .mobile-toggle-btn {
                position: fixed;
                top: 14px;
                left: 14px;
                z-index: 1010;
                width: 42px;
                height: 42px;
                border-radius: 12px;
                border: 1px solid var(--border);
                background: var(--white);
                color: var(--text-primary);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.4rem;
                box-shadow: 0 4px 12px rgba(18, 61, 50, 0.08);
            }

            /* ========== BREADCRUMB / PAGE HEADER ========== */
            .page-header {
                padding: 22px 28px 0;
            }

                .page-header h1 {
                    font-size: 1.35rem;
                    font-weight: 700;
                    margin: 0 0 4px;
                }

            .breadcrumb {
                margin: 0;
                font-size: 0.82rem;
            }

            .breadcrumb-item a {
                color: var(--text-secondary);
                text-decoration: none;
            }

                .breadcrumb-item a:hover {
                    color: var(--primary-accent);
                }

            .breadcrumb-item.active {
                color: var(--primary-accent);
                font-weight: 600;
            }

            .breadcrumb-item + .breadcrumb-item::before {
                content: "/";
                color: color-mix(in srgb, var(--text-2) 40%, white);
            }

            /* ========== CONTENT (RenderBody) ========== */
            .main-body-container {
                flex: 1;
                padding: 20px 28px 28px;
                min-width: 0;
            }

                .main-body-container .table {
                    background: var(--card-bg);
                }

                .main-body-container .table-responsive,
                .main-body-container table {
                    max-width: 100%;
                }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary-accent);
                box-shadow: 0 0 0 3px rgba(22, 132, 91, 0.14);
            }

            /* ========== FOOTER ========== */
            .admin-footer {
                border-top: 1px solid var(--border-color);
                background: #fff;
                padding: 16px 28px;
                font-size: 0.8rem;
                color: var(--text-secondary);
                display: flex;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 8px;
            }

                .admin-footer a {
                    color: var(--text-secondary);
                    text-decoration: none;
                }

                    .admin-footer a:hover {
                        color: var(--primary-accent);
                    }

            /* ========== MOBILE ========== */
            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(18, 61, 50, 0.45);
                z-index: 1029;
            }

            @@media (max-width: 991.98px) {
                #sidebar-wrapper {
                    transform: translateX(-100%);
                }

                body.sidebar-open #sidebar-wrapper {
                    transform: translateX(0);
                }

                body.sidebar-open .sidebar-overlay {
                    display: block;
                }

                #main-content-wrapper {
                    margin-left: 0;
                }

                .page-header, .main-body-container, .admin-footer {
                    padding-left: 16px;
                    padding-right: 16px;
                }
            }

            /* ===== SWEETALERT2 STYLES ===== */
            .swal2-actions {
                gap: 12px !important;
            }

            .swal2-btn-cancel {
                background-color: #ffffff !important;
                color: #17231D !important;
                border: 1px solid #D5DDDB !important;
                border-radius: 10px !important;
                padding: 8px 18px !important;
                font-weight: 600 !important;
                font-size: 0.875rem !important;
                box-shadow: none !important;
                margin: 0 !important;
            }

                .swal2-btn-cancel:hover {
                    background-color: #EEF6F0 !important;
                }

            .swal2-btn-confirm {
                background-color: #16845B !important;
                color: #ffffff !important;
                border: none !important;
                border-radius: 10px !important;
                padding: 8px 18px !important;
                font-weight: 600 !important;
                font-size: 0.875rem !important;
                box-shadow: 0 4px 12px rgba(22, 132, 91, 0.3) !important;
                margin: 0 !important;
            }

                .swal2-btn-confirm:hover {
                    background-color: #123D32 !important;
                }
    </style>
