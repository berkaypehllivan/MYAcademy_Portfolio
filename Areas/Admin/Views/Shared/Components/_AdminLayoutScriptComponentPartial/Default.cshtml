<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function toggleSidebar() {
        document.body.classList.toggle("sidebar-open");
    }
</script>

<script>
    function decreaseUnreadBadge() {
    const badge = document.getElementById('sidebarUnreadBadge');
    if (!badge) return;

    const count = Math.max(0, parseInt(badge.dataset.count) - 1);
    badge.dataset.count = count;
    badge.textContent = count > 99 ? '99+' : count;
    badge.classList.toggle('d-none', count === 0);
}

</script>

<script>
document.addEventListener('click', function (e) {
    const btn = e.target.closest('.btn-delete');
    if (!btn) return;

    e.preventDefault();

    Swal.fire({
        title: 'Emin misin?',
        text: (btn.dataset.name ? '"' + btn.dataset.name + '"' : 'Bu kayıt') + ' kalıcı olarak silinecek.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Evet, sil',
        cancelButtonText: 'Vazgeç',
        reverseButtons: false,
        buttonsStyling: false,
        customClass: {
            confirmButton: 'swal2-btn-confirm',
            cancelButton: 'swal2-btn-cancel'
        }
    }).then(function (result) {
        if (result.isConfirmed) {
            window.location.href = btn.href;
        }
    });
});
</script>


@if (TempData["Error"] is string errorMessage)
{
    <script>
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'error',
            iconColor: '#DC2626',
            title: @Html.Raw(Json.Serialize(errorMessage)),
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            background: '#FFFFFF',
            color: '#1F2937',
            customClass: {
                popup: 'colored-toast'
            }
        });
    </script>
}

@if (TempData["Success"] is string successMessage)
{
    <script>
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            iconColor: '#16845B',
            title: @Html.Raw(Json.Serialize(successMessage)),
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            background: '#FFFFFF',
            color: '#1F2937',
            customClass: {
                popup: 'colored-toast'
            }
        });
    </script>
}

}
