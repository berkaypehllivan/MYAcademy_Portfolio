@model MYAcademy_Portfolio.Entities.Contact
@{
    ViewData["Title"] = "İletişim Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-0 py-3">

    <div class="card border-0 shadow-sm rounded-4">
        <form asp-area="Admin" asp-controller="Contact" asp-action="Index" method="post">

            <div class="card-header bg-transparent border-bottom p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3 flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        📞
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-0 fs-6">İletişim Bilgileri</h5>
                        <small class="text-muted">Public sayfadaki iletişim kısmı bu bilgilerden oluşur.</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-dark">E-Posta <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="Örn: berkay@pehlivan.com" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small text-dark">Telefon <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control rounded-3" placeholder="+90 5XX XXX XX XX" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label fw-semibold small text-dark">Konum <span class="text-danger">*</span></label>
                        <input asp-for="Location" class="form-control rounded-3" placeholder="Örn: İzmir, Türkiye" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Linkedin" class="form-label fw-semibold small text-dark">Linkedin <span class="text-danger">*</span></label>
                        <input asp-for="Linkedin" class="form-control rounded-3" placeholder="https://www.linkedin.com/in/username" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Github" class="form-label fw-semibold small text-dark">Github <span class="text-danger">*</span></label>
                        <input asp-for="Github" class="form-control rounded-3" placeholder="https://github.com/username" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SubDescription" class="form-label fw-semibold small text-dark">Alt Başlık <span class="text-danger">*</span></label>
                        <input asp-for="SubDescription" class="form-control rounded-3" placeholder="Genellikle 24 saat içerisinde yanıt verilir." required />
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small text-dark">Açıklama <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="4" required></textarea>
                    </div>

                </div>
            </div>

            <div class="card-footer bg-light border-top p-3 d-flex justify-content-end rounded-bottom-4">
                <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-medium">
                    Kaydet
                </button>
            </div>
        </form>
    </div>

</div>