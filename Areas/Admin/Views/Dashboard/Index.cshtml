@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    // ---------- Controller'dan gelen veriler ----------
    int projectCount = ViewBag.projectCount ?? 0;
    int categoryCount = ViewBag.categoryCount ?? 0;
    int skillCount = ViewBag.skillCount ?? 0;
    int experienceCount = ViewBag.experienceCount ?? 0;
    int educationCount = ViewBag.educationCount ?? 0;

    int total = ViewBag.messageCount ?? 0;
    int readCount = ViewBag.messageReadByTrueCount ?? 0;
    int unreadCount = ViewBag.messageReadByFalseCount ?? 0;

    int aboutFilled = ViewBag.aboutFilled ?? 0;
    int aboutTotal = ViewBag.aboutTotal ?? 0;
    int contactFilled = ViewBag.contactFilled ?? 0;
    int contactTotal = ViewBag.contactTotal ?? 0;

    var byCategory = ViewBag.projectsByCategory as Dictionary<string, int> ?? new Dictionary<string, int>();
    var monthly = ViewBag.messagesByMonth as Dictionary<string, int> ?? new Dictionary<string, int>();
    var workTypes = ViewBag.workTypes as Dictionary<string, int> ?? new Dictionary<string, int>();
    var topSkills = ViewBag.topSkills as Dictionary<string, int> ?? new Dictionary<string, int>();
    int activeExp = ViewBag.activeExperienceCount ?? 0;
    int demoCount = ViewBag.projectDemoCount ?? 0;
    int keywordProjects = ViewBag.projectKeywordCount ?? 0;
    int keywordTotal = ViewBag.keywordTotal ?? 0;
    var experiences = ViewBag.experiences as List<(string Title, string Sub, string Period)> ?? new List<(string Title, string Sub, string Period)>();
    var educations = ViewBag.educations as List<(string Title, string Sub, string Period)> ?? new List<(string Title, string Sub, string Period)>();
    var recent = ViewBag.recentMessages as List<(string Name, string Email, string Subject, string Date, bool IsRead)> ?? new List<(string Name, string Email, string Subject, string Date, bool IsRead)>();

    // ---------- Yardımcılar ----------
    int Pct(int a, int b) => b > 0 ? (int)Math.Round(a * 100.0 / b) : 0;
    string Num(double d) => d.ToString("0.##", CultureInfo.InvariantCulture); // tr-TR'de virgül CSS'i bozar
    string Initials(string n)
    {
        var p = (n ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 0) return "?";
        return (p.Length == 1 ? p[0][..1] : p[0][..1] + p[^1][..1]).ToUpper();
    }

    int readPercent = Pct(readCount, total);
    int unreadPercent = total > 0 ? 100 - readPercent : 0;
    int profilePercent = Pct(aboutFilled + contactFilled, aboutTotal + contactTotal);

    // Proje / kategori donut (çok dilimli conic-gradient)
    var palette = new[] { "var(--emerald)", "var(--info)", "var(--warning)", "var(--forest)", "var(--success)", "var(--danger)" };
    int catTotal = byCategory.Values.Sum();
    string conic = "var(--soft) 0 100%";
    if (catTotal > 0)
    {
        double acc = 0; int i = 0; var parts = new List<string>();
        foreach (var kv in byCategory)
        {
            double p = kv.Value * 100.0 / catTotal;
            parts.Add($"{palette[i % palette.Length]} {Num(acc)}% {Num(acc + p)}%");
            acc += p; i++;
        }
        conic = string.Join(", ", parts);
    }

    int maxMonth = monthly.Count > 0 ? monthly.Values.Max() : 0;
    int workTotal = workTypes.Values.Sum();
    int maxKw = topSkills.Count > 0 ? topSkills.Values.Max() : 0;
}
@section Styles {
<style>
    .pd { color: var(--text); }
    .pd h1, .pd h2, .pd h3, .pd h4, .pd h5, .pd p { margin: 0; }
    
    .pd-card { background: var(--white); border: 1px solid var(--border); border-radius: 16px; padding: 22px; height: 100%; }
    .pd-card-title { font-size: 15px; font-weight: 600; color: var(--text); }
    .pd-card-sub { font-size: 12px; color: var(--text-2); margin-top: 2px; }
    .pd-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 18px; }
    .pd-link { font-size: 13px; font-weight: 500; color: var(--emerald); text-decoration: none; }
    .pd-link:hover { color: var(--forest); text-decoration: underline; }

    .pd-page-title { font-size: 26px; font-weight: 700; color: var(--forest); letter-spacing: -0.02em; }
    .pd-page-sub { font-size: 14px; color: var(--text-2); margin-top: 4px; }

    .pd-stat { display: flex; align-items: center; gap: 14px; }
    .pd-ico { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
    .pd-ico.green { background: var(--mint); color: var(--emerald); }
    .pd-ico.info { background: color-mix(in srgb, var(--info) 12%, white); color: var(--info); }
    .pd-ico.warn { background: color-mix(in srgb, var(--warning) 12%, white); color: var(--warning); }
    .pd-ico.danger { background: color-mix(in srgb, var(--danger) 12%, white); color: var(--danger); }
    .pd-ico.forest { background: var(--forest); color: var(--mint); }

    .pd-stat-lbl { font-size: 13px; color: var(--text-2); font-weight: 500; }
    .pd-stat-val { font-size: 28px; font-weight: 700; line-height: 1.15; color: var(--text); }
    .pd-stat-note { font-size: 12px; color: var(--text-2); }

    .pd-donut-wrap { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
    .pd-donut { width: 150px; height: 150px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pd-donut-in { width: 104px; height: 104px; background: var(--white); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .pd-donut-in strong { font-size: 24px; font-weight: 700; color: var(--text); line-height: 1.1; }
    .pd-donut-in small { font-size: 11px; color: var(--text-2); }

    .pd-legend { list-style: none; padding: 0; margin: 0; font-size: 13px; display: grid; gap: 8px; flex: 1; min-width: 140px; }
    .pd-legend li { display: flex; align-items: center; gap: 8px; color: var(--text); }
    .pd-legend li b { margin-left: auto; font-weight: 600; }
    .pd-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }

    .pd-cols { display: flex; align-items: stretch; gap: 14px; height: 210px; }
    .pd-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .pd-col-val { font-size: 12px; font-weight: 600; color: var(--text); }
    .pd-col-track { flex: 1; width: 100%; display: flex; align-items: flex-end; background: var(--soft); border-radius: 8px; overflow: hidden; }
    .pd-col-bar { width: 100%; min-height: 4px; background: linear-gradient(180deg, var(--emerald), var(--forest)); border-radius: 8px 8px 0 0; }
    .pd-col-lbl { font-size: 12px; color: var(--text-2); }

    .pd-bar-row { margin-bottom: 16px; }
    .pd-bar-row:last-child { margin-bottom: 0; }
    .pd-bar-top { display: flex; justify-content: space-between; font-size: 13px; font-weight: 500; margin-bottom: 6px; }
    .pd-bar-top span:last-child { color: var(--text-2); font-weight: 400; }
    .pd-track { height: 9px; background: var(--soft); border-radius: 999px; overflow: hidden; }
    .pd-fill { height: 100%; border-radius: 999px; background: var(--emerald); }
    .pd-fill.warn { background: var(--warning); }
    .pd-fill.info { background: var(--info); }
    .pd-fill.forest { background: var(--forest); }

    .pd-stack { display: flex; height: 16px; border-radius: 999px; overflow: hidden; background: var(--soft); margin-bottom: 16px; }

    .pd-timeline { list-style: none; margin: 0; padding: 0 0 0 4px; }
    .pd-timeline li { position: relative; padding: 0 0 18px 22px; border-left: 2px solid var(--border); }
    .pd-timeline li:last-child { padding-bottom: 0; border-left-color: transparent; }
    .pd-timeline li::before { content: ""; position: absolute; left: -6px; top: 3px; width: 10px; height: 10px; border-radius: 50%; background: var(--emerald); box-shadow: 0 0 0 3px var(--mint); }
    .pd-tl-title { font-size: 14px; font-weight: 600; }
    .pd-tl-sub { font-size: 13px; color: var(--text-2); }
    .pd-tl-period { font-size: 12px; color: var(--emerald); font-weight: 500; margin-top: 2px; }

    .pd-table { width: 100%; border-collapse: collapse; }
    .pd-table th { background: var(--soft); color: var(--text-2); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; padding: 11px 14px; text-align: left; }
    .pd-table th:first-child { border-radius: 10px 0 0 10px; }
    .pd-table th:last-child { border-radius: 0 10px 10px 0; }
    .pd-table td { padding: 12px 14px; border-bottom: 1px solid var(--border); font-size: 14px; vertical-align: middle; }
    .pd-table tr:last-child td { border-bottom: 0; }
    .pd-table tbody tr:hover { background: var(--bg); }

    .pd-person { display: flex; align-items: center; gap: 12px; }
    .pd-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--mint); color: var(--forest); font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .pd-person small { display: block; color: var(--text-2); font-size: 12px; }
    .pd-badge { display: inline-block; font-size: 12px; font-weight: 500; padding: 3px 12px; border-radius: 999px; }
    .pd-badge.ok { background: var(--mint); color: var(--success); }
    .pd-badge.warn { background: color-mix(in srgb, var(--warning) 14%, white); color: var(--warning); }

    .pd-quick { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-size: 14px; font-weight: 500; text-decoration: none; background: var(--white); transition: all .15s; }
    .pd-quick:hover { background: var(--soft); border-color: var(--emerald); color: var(--forest); }
    .pd-empty { font-size: 13px; color: var(--text-2); padding: 18px 0; text-align: center; }

    @@media (max-width: 575px) {
        .pd-cols { gap: 8px; }
        .pd-card { padding: 16px; }
    }
</style>
}
<div class="pd container-fluid px-0 py-3">

<!-- ========== YENİ PAGE HEADER TASARIMI ========== -->
<div class="pd-page-header">
    <div class="pd-header-left">
        <div class="pd-header-icon">
            <i class="bx-pie-chart-alt-2"></i>
        </div>
        <div class="pd-header-text">
            <h1 class="pd-title">Dashboard</h1>
            <p class="pd-subtitle">Portfolyo sitenizin içerik ve mesaj istatistiklerine genel bakış.</p>
        </div>
    </div>
    </div>
    <!-- İstatistik kartları -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="pd-card">
                <div class="pd-stat">
                    <div class="pd-ico forest">📁</div>
                    <div><div class="pd-stat-lbl">Projeler</div><div class="pd-stat-val">@projectCount</div><div class="pd-stat-note">@categoryCount kategoride</div></div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="pd-card">
                <div class="pd-stat">
                    <div class="pd-ico green">🛠</div>
                    <div><div class="pd-stat-lbl">Yetenekler</div><div class="pd-stat-val">@skillCount</div><div class="pd-stat-note">@keywordTotal anahtar kelime</div></div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="pd-card">
                <div class="pd-stat">
                    <div class="pd-ico info">💼</div>
                    <div><div class="pd-stat-lbl">Deneyimler</div><div class="pd-stat-val">@experienceCount</div><div class="pd-stat-note">@activeExp aktif</div></div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="pd-card">
                <div class="pd-stat">
                    <div class="pd-ico info">🎓</div>
                    <div><div class="pd-stat-lbl">Eğitim</div><div class="pd-stat-val">@educationCount</div><div class="pd-stat-note">Eğitim kaydı</div></div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="pd-card">
                <div class="pd-stat">
                    <div class="pd-ico green">✉</div>
                    <div><div class="pd-stat-lbl">Toplam Mesaj</div><div class="pd-stat-val">@total</div><div class="pd-stat-note">Tüm zamanlar</div></div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="pd-card">
                <div class="pd-stat">
                    <div class="pd-ico green">✔</div>
                    <div><div class="pd-stat-lbl">Okunmuş Mesaj</div><div class="pd-stat-val">@readCount</div><div class="pd-stat-note">%@readPercent oranında</div></div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="pd-card">
                <div class="pd-stat">
                    <div class="pd-ico warn">●</div>
                    <div><div class="pd-stat-lbl">Okunmamış Mesaj</div><div class="pd-stat-val">@unreadCount</div><div class="pd-stat-note">%@unreadPercent oranında</div></div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="pd-card">
                <div class="pd-stat">
                    <div class="pd-ico danger">👤</div>
                    <div><div class="pd-stat-lbl">Profil Doluluğu</div><div class="pd-stat-val">%@profilePercent</div><div class="pd-stat-note">Hakkımda + İletişim</div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Projeler & Mesaj trendi -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="pd-card">
                <div class="pd-head">
                    <div><div class="pd-card-title">Kategoriye Göre Projeler</div><div class="pd-card-sub">Proje dağılımı</div></div>
                    <a href="/Admin/Project/Index" class="pd-link">Projeler →</a>
                </div>
                @if (catTotal == 0)
                {
                    <div class="pd-empty">Henüz proje eklenmemiş.</div>
                }
                else
                {
                    <div class="pd-donut-wrap">
                        <div class="pd-donut" style="background: conic-gradient(@Html.Raw(conic));">
                            <div class="pd-donut-in"><strong>@projectCount</strong><small>proje</small></div>
                        </div>
                        <ul class="pd-legend">
                            @{
                                int li = 0;
                            }
                            @foreach (var kv in byCategory)
                            {
                                <li><span class="pd-dot" style="background: @Html.Raw(palette[li % palette.Length]);"></span>@kv.Key <b>@kv.Value</b></li>
                                li++;
                            }
                        </ul>
                    </div>
                    <div style="margin-top: 22px;">
                        <div class="pd-bar-row">
                            <div class="pd-bar-top"><span>Canlı demo linki olan</span><span>@demoCount / @projectCount</span></div>
                            <div class="pd-track"><div class="pd-fill info" style="width: @(Pct(demoCount, projectCount))%;"></div></div>
                        </div>
                        <div class="pd-bar-row">
                            <div class="pd-bar-top"><span>Anahtar kelimesi olan</span><span>@keywordProjects / @projectCount</span></div>
                            <div class="pd-track"><div class="pd-fill forest" style="width: @(Pct(keywordProjects, projectCount))%;"></div></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="pd-card">
                <div class="pd-head">
                    <div><div class="pd-card-title">Aylık Mesaj Trendi</div><div class="pd-card-sub">Son 6 ay</div></div>
                    <a href="/Admin/Message/Index" class="pd-link">Mesajlar →</a>
                </div>
                <div class="pd-cols">
                    @foreach (var kv in monthly)
                    {
                        int h = maxMonth > 0 ? (int)Math.Round(kv.Value * 100.0 / maxMonth) : 0;
                        <div class="pd-col">
                            <span class="pd-col-val">@kv.Value</span>
                            <div class="pd-col-track"><div class="pd-col-bar" style="height: @(h)%;"></div></div>
                            <span class="pd-col-lbl">@kv.Key</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Mesaj durumu & Profil doluluğu -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="pd-card">
                <div class="pd-head"><div><div class="pd-card-title">Mesaj Durumu</div><div class="pd-card-sub">Okunma oranı</div></div></div>
                <div class="pd-donut-wrap">
                    <div class="pd-donut" style="background: conic-gradient(var(--success) 0 @(readPercent)%, var(--warning) @(readPercent)% 100%);">
                        <div class="pd-donut-in"><strong>@readPercent%</strong><small>okundu</small></div>
                    </div>
                    <div style="flex:1; min-width:180px;">
                        <div class="pd-bar-row">
                            <div class="pd-bar-top"><span>Okunmuş</span><span>@readCount / @total</span></div>
                            <div class="pd-track"><div class="pd-fill" style="width: @(readPercent)%;"></div></div>
                        </div>
                        <div class="pd-bar-row">
                            <div class="pd-bar-top"><span>Okunmamış</span><span>@unreadCount / @total</span></div>
                            <div class="pd-track"><div class="pd-fill warn" style="width: @(unreadPercent)%;"></div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="pd-card">
                <div class="pd-head">
                    <div><div class="pd-card-title">Profil Doluluğu</div><div class="pd-card-sub">Doldurulan alan sayısı</div></div>
                </div>
                <div class="pd-bar-row">
                    <div class="pd-bar-top"><span>Hakkımda</span><span>@aboutFilled / @aboutTotal alan</span></div>
                    <div class="pd-track"><div class="pd-fill forest" style="width: @(Pct(aboutFilled, aboutTotal))%;"></div></div>
                </div>
                <div class="pd-bar-row">
                    <div class="pd-bar-top"><span>İletişim</span><span>@contactFilled / @contactTotal alan</span></div>
                    <div class="pd-track"><div class="pd-fill info" style="width: @(Pct(contactFilled, contactTotal))%;"></div></div>
                </div>
                <div class="pd-bar-row">
                    <div class="pd-bar-top"><span>Genel</span><span>%@profilePercent</span></div>
                    <div class="pd-track"><div class="pd-fill" style="width: @(profilePercent)%;"></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Deneyim durumu & Yetenekler -->
    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="pd-card">
                <div class="pd-head">
                    <div><div class="pd-card-title">Çalışma Türü Dağılımı</div><div class="pd-card-sub">@activeExp / @experienceCount deneyim aktif</div></div>
                </div>
                @if (workTotal == 0)
                {
                    <div class="pd-empty">Henüz deneyim eklenmemiş.</div>
                }
                else
                {
                    <div class="pd-stack">
                        @{
                            int wi = 0;
                        }
                        @foreach (var kv in workTypes)
                        {
                            <div style="width: @Num(kv.Value * 100.0 / workTotal)%; background: @Html.Raw(palette[wi % palette.Length]);" title="@kv.Key: @kv.Value"></div>
                            wi++;
                        }
                    </div>
                    <ul class="pd-legend">
                        @{
                            wi = 0;
                        }
                        @foreach (var kv in workTypes)
                        {
                            <li><span class="pd-dot" style="background: @Html.Raw(palette[wi % palette.Length]);"></span>@kv.Key <b>@kv.Value</b></li>
                            wi++;
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="pd-card">
                <div class="pd-head">
                    <div><div class="pd-card-title">Yetenek Başına Anahtar Kelime</div><div class="pd-card-sub">En çok anahtar kelimesi olan 6 yetenek</div></div>
                    <a href="/Admin/Skill/Index" class="pd-link">Yetenekler →</a>
                </div>
                @if (topSkills.Count == 0)
                {
                    <div class="pd-empty">Gösterilecek yetenek yok.</div>
                }
                @foreach (var kv in topSkills)
                {
                    <div class="pd-bar-row">
                        <div class="pd-bar-top"><span>@kv.Key</span><span>@kv.Value kelime</span></div>
                        <div class="pd-track"><div class="pd-fill" style="width: @(Pct(kv.Value, maxKw))%;"></div></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Deneyim & Eğitim -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="pd-card">
                <div class="pd-head">
                    <div><div class="pd-card-title">Deneyim Geçmişi</div><div class="pd-card-sub">Son kayıtlar</div></div>
                    <a href="/Admin/Experience/Index" class="pd-link">Tümü →</a>
                </div>
                @if (experiences.Count == 0)
                {
                    <div class="pd-empty">Henüz deneyim eklenmemiş.</div>
                }
                else
                {
                    <ul class="pd-timeline">
                        @foreach (var e in experiences)
                        {
                            <li>
                                <div class="pd-tl-title">@e.Title</div>
                                <div class="pd-tl-sub">@e.Sub</div>
                                <div class="pd-tl-period">@e.Period</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="pd-card">
                <div class="pd-head">
                    <div><div class="pd-card-title">Eğitim Geçmişi</div><div class="pd-card-sub">Son kayıtlar</div></div>
                    <a href="/Admin/Education/Index" class="pd-link">Tümü →</a>
                </div>
                @if (educations.Count == 0)
                {
                    <div class="pd-empty">Henüz eğitim eklenmemiş.</div>
                }
                else
                {
                    <ul class="pd-timeline">
                        @foreach (var e in educations)
                        {
                            <li>
                                <div class="pd-tl-title">@e.Title</div>
                                <div class="pd-tl-sub">@e.Sub</div>
                                <div class="pd-tl-period">@e.Period</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <!-- Son mesajlar -->
    <div class="pd-card mb-4">
        <div class="pd-head">
            <div class="pd-card-title">Son Mesajlar</div>
            <a href="/Admin/Message/Index" class="pd-link">Tümünü gör →</a>
        </div>
        @if (recent.Count == 0)
        {
            <div class="pd-empty">Henüz mesaj yok.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="pd-table">
                    <thead>
                        <tr><th>Gönderen</th><th>Konu</th><th>Tarih</th><th>Durum</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in recent)
                        {
                            <tr>
                                <td>
                                    <div class="pd-person">
                                        <span class="pd-avatar">@Initials(m.Name)</span>
                                        <div>@m.Name<small>@m.Email</small></div>
                                    </div>
                                </td>
                                <td>@m.Subject</td>
                                <td style="color: var(--text-2); font-size: 13px;">@m.Date</td>
                                <td>
                                    @if (m.IsRead)
                                    {
                                        <span class="pd-badge ok">Okundu</span>
                                    }
                                    else
                                    {

                                        <span class="pd-badge warn">Okunmadı</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Hızlı erişim -->
    <div class="pd-card">
        <div class="pd-head"><div class="pd-card-title">Hızlı Erişim</div></div>
        <div class="row g-3">
            <div class="col-6 col-md-3"><a class="pd-quick" href="/Admin/Project/Index">📁 Projeler</a></div>
            <div class="col-6 col-md-3"><a class="pd-quick" href="/Admin/ProjectCategory/Index">🗂 Kategoriler</a></div>
            <div class="col-6 col-md-3"><a class="pd-quick" href="/Admin/Skill/Index">🛠 Yetenekler</a></div>
            <div class="col-6 col-md-3"><a class="pd-quick" href="/Admin/Experience/Index">💼 Deneyimler</a></div>
            <div class="col-6 col-md-3"><a class="pd-quick" href="/Admin/Education/Index">🎓 Eğitim</a></div>
            <div class="col-6 col-md-3"><a class="pd-quick" href="/Admin/About/Index">👤 Hakkımda</a></div>
            <div class="col-6 col-md-3"><a class="pd-quick" href="/Admin/Contact/Index">📞 İletişim</a></div>
            <div class="col-6 col-md-3"><a class="pd-quick" href="/Admin/Message/Index">✉ Mesajlar</a></div>
        </div>
    </div>

</div>
