@model List<MYAcademy_Portfolio.Entities.Skill>
@{
    ViewData["Title"] = "Yetenek Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-0 py-3">
    <div class="pd-page-header">
        <div class="pd-header-left">
            <div class="pd-header-icon">
                <i class="bx bx-code-alt"></i>
            </div>
            <div class="pd-header-text">
                <h1 class="pd-title">Yetenekler ve Teknolojiler</h1>
                <p class="pd-subtitle">Sahip olduğunuz teknik becerileri, kullandığınız araçları ve uzmanlık
                    alanlarınızı portfolyonuza ekleyin.</p>
                </div>
            </div>
        
                <div class="pd-header-text">
                    <a href="/Admin/Skill/Create" class="btn btn-primary px-3 py-2 rounded-3 ms-auto">
                        <i class="bx bx-plus"></i> Yeni Yetenek Ekle
                    </a>
                </div>
        </div>
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #f9fafb;">
                            <tr>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600;">Grup Adı</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600; max-width: 200px;">Açıklama</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600;">Alt Yetenekler (Etiketler)</th>
                                <th class="border-bottom-0 text-uppercase text-secondary"
                                    style="font-size: 12px; font-weight: 600;">Aktif - Pasif</th>
                                <th class="border-bottom-0 text-uppercase text-secondary text-end"
                                    style="font-size: 12px; font-weight: 600;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-medium text-dark">@item.Title</td>
                                    <td class="text-muted small" style="max-width: 200px;">
                                        <div class="text-truncate" title="@item.Description">@item.Description</div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (!string.IsNullOrEmpty(item.Keywords))
                                            {
                                                foreach (var tag in item.Keywords.Split(new[] { ',' },
                                        StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    <span class="badge bg-light text-dark border fw-normal px-2 py-1 rounded-pill">
                                                        <span class="text-success fw-bold">✓</span> @tag.Trim()
                                                    </span>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span
                                            class="badge rounded-pill px-3 py-2 fw-medium @(item.IsActive ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">
                                            @(item.IsActive ? "Aktif" : "Pasif")
                                        </span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a href="/Admin/Skill/Create/@item.SkillId"
                                           class="btn btn-sm text-primary bg-primary bg-opacity-10 border-0 rounded-pill px-3 me-1 fw-medium">Düzenle</a>
                                        <a href="/Admin/Skill/Delete/@item.SkillId"
                                           class="btn btn-sm text-danger bg-danger bg-opacity-10 border-0 rounded-pill px-3 fw-medium btn-delete">Sil</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>