@model List<MYAcademy_Portfolio.Entities.Skill>
@{
    ViewData["Title"] = "Yetenek Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-0 py-3">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-transparent border-bottom p-4">
        
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3 flex-shrink-0"
             style="width: 44px; height: 44px; font-size: 1.25rem;">
             <div class="pd-ico green">🛠</div>
        </div>

        <div>
            <h5 class="fw-bold text-dark mb-0 fs-6">Yetenekler Bilgileri</h5>
            <small class="text-muted">
                Public sayfadaki yeteneklerim kısmı bu bilgilerden oluşur.
            </small>
        </div>

        <a href="/Admin/Skill/Create"
           class="btn btn-primary px-3 py-2 rounded-3 ms-auto">
            <i class="bx bx-plus"></i> Yeni Yetenek Ekle
        </a>
    </div>
</div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f9fafb;">
                        <tr>
                            <th class="border-bottom-0 text-uppercase text-secondary" style="font-size: 12px; font-weight: 600;">Grup Adı</th>
                            <th class="border-bottom-0 text-uppercase text-secondary" style="font-size: 12px; font-weight: 600; max-width: 200px;">Açıklama</th>
                            <th class="border-bottom-0 text-uppercase text-secondary" style="font-size: 12px; font-weight: 600;">Alt Yetenekler (Etiketler)</th>
                            <th class="border-bottom-0 text-uppercase text-secondary text-end" style="font-size: 12px; font-weight: 600;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-medium text-dark">@item.Title</td>
                                <td class="text-muted small" style="max-width: 200px;">
                                    <div class="text-truncate" title="@item.Description">@item.Description</div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (!string.IsNullOrEmpty(item.Keywords))
                                        {
                                            foreach (var tag in item.Keywords.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge bg-light text-dark border fw-normal px-2 py-1 rounded-pill">
                                                    <span class="text-success fw-bold">✓</span> @tag.Trim()
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a href="/Admin/Skill/Create/@item.SkillId" class="btn btn-sm text-primary bg-primary bg-opacity-10 border-0 rounded-pill px-3 me-1 fw-medium">Düzenle</a>
                                    <a href="/Admin/Skill/Delete/@item.SkillId" class="btn btn-sm text-danger bg-danger bg-opacity-10 border-0 rounded-pill px-3 fw-medium btn-delete">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>