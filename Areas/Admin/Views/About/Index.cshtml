@model MYAcademy_Portfolio.Entities.About
@{
    ViewData["Title"] = "Hakkımda Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-0 py-3">
<div class="pd-page-header">
    <div class="pd-header-left">
        <div class="pd-header-icon">
            <i class="bx bx-user"></i>
        </div>
        <div class="pd-header-text">
            <h1 class="pd-title">Hakkımda</h1>
            <p class="pd-subtitle">Kişisel bilgilerinizi, profil görselinizi ve ziyaretçilere sunacağınız biyografinizi buradan güncelleyin.</p>
        </div>
    </div>
</div>
    <div class="card border-0 shadow-sm rounded-4">
        <form asp-area="Admin" asp-controller="About" asp-action="Index" method="post" enctype="multipart/form-data">
                        <div class="card-body p-4">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="FirstLastName" class="form-label fw-semibold small text-dark">Ad Soyad <span class="text-danger">*</span></label>
                        <input asp-for="FirstLastName" class="form-control rounded-3" placeholder="Örn: Berkay Pehlivan" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="JobTitle" class="form-label fw-semibold small text-dark">Meslek <span class="text-danger">*</span></label>
                        <input asp-for="JobTitle" class="form-control rounded-3" placeholder="Örn: Bilgisayar Mühendisi" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Education" class="form-label fw-semibold small text-dark">Eğitim <span class="text-danger">*</span></label>
                        <input asp-for="Education" class="form-control rounded-3" placeholder="Örn: Bilgisayar Mühendisi" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label fw-semibold small text-dark">Konum <span class="text-danger">*</span></label>
                        <input asp-for="Location" class="form-control rounded-3" placeholder="Örn: İstanbul, Türkiye" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small text-dark">E-Posta <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="iletisim@ornek.com" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small text-dark">Telefon <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control rounded-3" placeholder="+90 5XX XXX XX XX" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-dark">
                            Profil Görseli
                        </label>

                        <input type="file"
                               name="ImageFile"
                               class="form-control rounded-3"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <div class="form-text small">
                            JPG, PNG veya WEBP. Maksimum 5 MB.
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-3">
                                <img src="@Model.ImageUrl"
                                     alt="Profil görseli"
                                     class="rounded-3 border"
                                     style="width: 120px; height: 120px; object-fit: cover;" />
                            </div>
                        }
                    </div>

<div class="col-md-6">
    <label class="form-label fw-semibold small text-dark">CV Dosyası (PDF)</label>
    <input type="file"
           name="CvFile"
           class="form-control rounded-3"
           accept=".pdf" />
    <div class="form-text small">Sadece PDF formatı kabul edilir.</div>

    @if (!string.IsNullOrEmpty(Model?.CvUrl))
    {
        <div class="mt-2">
            <a href="@Model.CvUrl" target="_blank" class="btn btn-sm btn-outline-secondary rounded-3">
                <i class="bi bi-file-earmark-pdf"></i> Mevcut CV'yi Görüntüle
            </a>
        </div>
    }
</div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small text-dark">Biyografi <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="4" required></textarea>
                        <div class="form-text small">Paragrafları boş satırla ayırın.</div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light border-top p-3 d-flex justify-content-end rounded-bottom-4">
                <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-medium">
                    Kaydet
                </button>
            </div>
        </form>
    </div>
</div>