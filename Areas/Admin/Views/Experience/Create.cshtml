@model MYAcademy_Portfolio.Entities.Experience
@{
    bool isUpdate = Model != null && Model.ExperienceId > 0;
    ViewData["Title"] = isUpdate ? "Deneyim Güncelle" : "Yeni Deneyim Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-0 py-3">

    <div class="row g-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4">
                <form asp-area="Admin" asp-controller="Experience" asp-action="@(isUpdate ? "Update" : "Create")" method="post">
                    
                    <input type="hidden" asp-for="ExperienceId" />

                    <div class="card-header bg-transparent border-bottom p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-3 flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                                💼
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0 fs-6">@(isUpdate ? "Deneyim Bilgisini Güncelle" : "Yeni Deneyim Ekle")</h5>
                                <small class="text-muted">İş tecrübelerinizi timeline alanında görünmesi için buradan yönetebilirsiniz.</small>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-3">
                            
                            <!-- Pozisyon & Şirket -->
                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-semibold small text-dark">Pozisyon (Title) <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control rounded-3" placeholder="Örn: Software Engineer" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-semibold small text-dark">Şirket Adı <span class="text-danger">*</span></label>
                                <input asp-for="CompanyName" class="form-control rounded-3" placeholder="Örn: NovaTech Solutions" required />
                            </div>

                            <!-- Tarih & Tip -->
                            <div class="col-md-6">
                                <label asp-for="Duration" class="form-label fw-semibold small text-dark">Tarih Aralığı <span class="text-danger">*</span></label>
                                <input asp-for="Duration" class="form-control rounded-3" placeholder="Örn: 2024 - Günümüz" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="WorkType" class="form-label fw-semibold small text-dark">Çalışma Tipi <span class="text-danger">*</span></label>
                                <input asp-for="WorkType" class="form-control rounded-3" placeholder="Örn: Tam Zamanlı, Yarı Zamanlı" required />
                            </div>

                            <!-- Yan Başlık & Aktiflik -->
                            <div class="col-md-6">
                                <label asp-for="SideTitle" class="form-label fw-semibold small text-dark">Yan Başlık (Timeline Çizgisindeki) <span class="text-danger">*</span></label>
                                <input asp-for="SideTitle" class="form-control rounded-3" placeholder="Örn: Kurumsal Web Çözümleri" required />
                            </div>
                            <div class="col-md-6 d-flex align-items-center mt-4">
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" role="switch">
                                    <label class="form-check-label fw-medium ms-2" asp-for="IsActive">Şu an burada çalışıyorum (Aktif)</label>
                                </div>
                            </div>

                            <!-- Açıklama -->
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold small text-dark">Sorumluluklar (Açıklama) <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="5" placeholder="Her satıra bir sorumluluk gelecek şekilde Enter ile inerek yazın..." required></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-light border-top p-3 d-flex justify-content-end gap-2 rounded-bottom-4">
                        <a asp-area="Admin" asp-controller="Experience" asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium text-dark border-opacity-25">Vazgeç</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-medium">
                            @(isUpdate ? "Değişiklikleri Kaydet" : "Deneyimi Ekle")
                        </button>
                    </div>
                </form>
            </div>
        </div>
        </div>