@{
    Layout = null;

    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

}
<!DOCTYPE html>
<html lang="tr">
    
    @await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")
    
        @await RenderSectionAsync("Styles", required: false)
    <body>

        <!-- ==================== SIDEBAR ==================== -->
    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")
        <!-- ==================== MAIN ==================== -->
        <div id="main-content-wrapper">

            <button type="button" class="mobile-toggle-btn d-lg-none" onclick="toggleSidebar()" aria-label="Menü">
                <i class="bx bx-menu"></i>
            </button>

            <!-- CONTENT -->
            <main class="main-body-container">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="admin-footer">
                <span>© @DateTime.Now.Year Berkay. Portfolio Admin — Tüm hakları saklıdır.</span>
                <span>
                    <a href="/" target="_blank">Siteyi Görüntüle</a>
                    <span class="mx-2">•</span>
                    <span>v1.0</span>
                </span>
            </footer>
        </div>
                @await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
